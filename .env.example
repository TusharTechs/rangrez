# Meta Model API key (dev.meta.ai). Enables hosted SAM 3.1 and Muse Wonder.
MODEL_API_KEY=
# sim (default), assisted (you and your phone) or serial
RANGREZ_RIG=sim
# Serial port of the ESP32 when RANGREZ_RIG=serial ("virtual" for the emulated board)
RANGREZ_PORT=/dev/cu.usbserial-0001
# Camera: an index (Continuity Camera is often 1), a phone IP-webcam URL, or a video file
RANGREZ_CAMERA=0
# Set to 0 to stop recording campaigns to recordings/
RANGREZ_RECORD=1
# Set to 1 to force the offline policy and segmenter even with a key
RANGREZ_OFFLINE=0
