# Meta Model API key (dev.meta.ai). Enables hosted SAM 3.1 and Muse Wonder.
MODEL_API_KEY=
# sim (default), assisted (you and your phone) or serial
RANGREZ_RIG=sim
# Serial port of the ESP32 when RANGREZ_RIG=serial ("virtual" for the emulated board)
RANGREZ_PORT=/dev/cu.usbserial-0001
# Camera: an index (Continuity Camera is often 1), a phone IP-webcam URL, or a video file
RANGREZ_CAMERA=0
# Set to 0 to stop recording campaigns to recordings/
RANGREZ_RECORD=1
# Set to 1 to force the offline policy and segmenter even with a key
RANGREZ_OFFLINE=0
# Fireworks (Muse Glimmer fine-tuning): API key and account id from app.fireworks.ai
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=
# Optional: the deployed tuned Glimmer, to propose each campaign's first dip, e.g.
# accounts/<account>/models/<model>#accounts/<account>/deployments/<deployment>
GLIMMER_MODEL=
# ...or the published weights served on Modal (eval/glimmer_serve.py): its URL + /v1, and the key it generates
GLIMMER_BASE_URL=
GLIMMER_API_KEY=
# Optional: Hugging Face write token, to publish the fine-tuned Glimmer adapter openly
HF_TOKEN=
