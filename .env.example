# Meta Model API key (dev.meta.ai). Enables hosted SAM 3.1 and Muse Wonder.
MODEL_API_KEY=
# sim (default) or serial
RANGREZ_RIG=sim
# Serial port of the ESP32 when RANGREZ_RIG=serial
RANGREZ_PORT=/dev/cu.usbserial-0001
# Camera index for OpenCV (Continuity Camera is often 1)
RANGREZ_CAMERA=0
# Set to 1 to force the offline policy and segmenter even with a key
RANGREZ_OFFLINE=0
